# =============================================================================
# AgentForge Environment Configuration
# Copy this file to .env and fill in your API keys
# =============================================================================

# --- Anthropic (Primary LLM) ---
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- OpenAI (Fallback LLM) ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Brave Search API ---
# Get your key at: https://brave.com/search/api/
# Free tier: 2,000 queries/month
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# --- Model Configuration ---
# Primary Anthropic model (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5

# Fallback OpenAI model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2

# Max tokens for LLM responses
LLM_MAX_TOKENS=4096

# --- Research Configuration ---
# Maximum search results per source per sub-question
MAX_SEARCH_RESULTS=10

# Maximum number of critic revision loops (1-3 recommended)
MAX_REVISION_LOOPS=2

# Quality score threshold below which revision is triggered (0.0-1.0)
QUALITY_THRESHOLD=0.75

# Maximum sub-questions the planner can generate
MAX_SUB_QUESTIONS=5

# --- MCP Server Ports (if using SSE transport instead of stdio) ---
# Leave empty to use stdio transport (recommended)
MCP_BRAVE_PORT=
MCP_ARXIV_PORT=
MCP_WIKIPEDIA_PORT=

# --- Logging ---
LOG_LEVEL=INFO
